      {
        "parameters": {
          "jsCode": "const csvTexto = $input.first().json.data || $input.first().json.body || '';\nconst ultimaDataHora = $('Pegar Data da Última Ligação Salva').first().json.ultimaDataHora;\n\nconst delimitador = csvTexto.includes(';') ? ';' : ',';\nconst linhas = csvTexto.split('\\n').filter(l => l.trim() !== '');\nif (linhas.length < 2) return [];\n\nconst cabecalho = linhas[0].split(delimitador).map(c => c.trim());\nconst idxDuracao  = cabecalho.findIndex(c => c.toLowerCase().includes('dura'));\nconst idxDataHora = cabecalho.findIndex(c => c.toLowerCase().includes('data'));\nconst idxUsuario  = cabecalho.findIndex(c => c.toLowerCase().includes('usu'));\n\nfunction toSegundos(dur) {\n  const p = (dur || '').trim().split(':');\n  if (p.length !== 3) return 0;\n  return parseInt(p[0]) * 3600 + parseInt(p[1]) * 60 + parseInt(p[2]);\n}\n\n// Converte \"DD/MM/AAAA HH:MM:SS\" em timestamp comparavel\nfunction paraTimestamp(dataHora) {\n  const partes = (dataHora || '').trim().split(' ');\n  if (partes.length < 2) return 0;\n  const [dd, mm, yyyy] = partes[0].split('/').map(Number);\n  const [h, m, s] = partes[1].split(':').map(Number);\n  return new Date(yyyy, mm - 1, dd, h, m, s || 0).getTime();\n}\n\nfunction nomeSDR(usuario) {\n  const u = (usuario || '').trim();\n  const m = u.match(/^vendas\\s+\\d+\\s+(.+)$/i);\n  if (m) return m[1].trim();\n  return u;\n}\n\nconst limiteTimestamp = ultimaDataHora ? paraTimestamp(ultimaDataHora) : 0;\n\nreturn linhas.slice(1).reduce((acc, linha) => {\n  const colunas = linha.split(delimitador).map(c => c.trim());\n\n  const dataHora = idxDataHora >= 0 ? (colunas[idxDataHora] || '') : '';\n  const ts = paraTimestamp(dataHora);\n\n  // So mantem ligacoes mais novas que a ultima ja gravada na planilha\n  if (ts <= limiteTimestamp) return acc;\n\n  const duracao  = idxDuracao >= 0 ? (colunas[idxDuracao] || '00:00:00') : '00:00:00';\n  const atendida = toSegundos(duracao) >= 60 ? 'Sim' : 'Não';\n\n  const obj = {};\n  cabecalho.forEach((col, i) => { obj[col] = colunas[i] || ''; });\n\n  if (idxUsuario >= 0) obj[cabecalho[idxUsuario]] = nomeSDR(colunas[idxUsuario]);\n\n  obj['Atendida'] = atendida;\n\n  acc.push({ json: obj });\n  return acc;\n}, []);"
        },
