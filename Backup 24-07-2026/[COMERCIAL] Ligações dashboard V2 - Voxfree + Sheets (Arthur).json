        "id": "8e1c1525-8d46-42bb-b9bd-c49a64796673",
        "name": "Adicionar Ligações na Planilha",
        "retryOnFail": true,
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "2DSmp4SarxDNx6pV",
            "name": "Google Sheets account"
          }
