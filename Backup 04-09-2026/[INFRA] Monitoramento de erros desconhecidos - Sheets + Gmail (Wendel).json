      "parameters": {
        "jsCode": "const erros = items.map(item => {\n  const data = item.json;\n\n  return `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nERRO NA EXECUÇÃO ${data.ID}\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n📅 Data: ${data.DATA}\n⚠️ Erro: ${data.ERRO}\n🔧 Node: ${data.TIPO}\n\n💬 Mensagem:\n${data.MSG}\n\n🔄 Fluxo:\n${data.FLUXO}\n\n🔗 Execução:\n${data.URL}\n`;\n}).join('\\n');\n\nconst total = items.length;\n\nconst emailBody = `\nOlá,\n\nForam identificados ${total} erro${total !== 1 ? 's' : ''} nas execuções do n8n.\n\n${erros}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nTotal de erros: ${total}\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nAtenciosamente,\nMonitoramento n8n\n`.trim();\n\nreturn [\n  {\n    json: {\n      quantidade: total,\n      emailSubject: `[n8n] ${total} erro${total !== 1 ? 's' : ''} identificado${total !== 1 ? 's' : ''}`,\n      emailBody\n    }\n  }\n];"
      },
