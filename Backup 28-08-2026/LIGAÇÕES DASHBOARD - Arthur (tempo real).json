        "jsCode": "// Le o cookie salvo (memoria persistente do workflow) e verifica se ainda vale.\n// Cookie do VoxFree dura ate 5h (18000s), mas usamos janela de 60min por seguranca.\nconst staticData = $getWorkflowStaticData('global');\nconst agora = Date.now();\nconst validade = 60 * 60 * 1000; // 60 minutos em ms\n\nconst cookieValido = !!(staticData.cookie && staticData.cookieTimestamp\n  && (agora - staticData.cookieTimestamp) < validade);\n\nreturn [{\n  json: {\n    precisaLogar: !cookieValido,\n    cookie: cookieValido ? staticData.cookie : null,\n    reservation: $('Calcular Data').item.json.reservation\n  }\n}];"
      },
