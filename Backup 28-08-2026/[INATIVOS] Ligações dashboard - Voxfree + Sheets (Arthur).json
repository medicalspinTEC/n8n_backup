      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1824,
        -240
      ],
      "id": "4c84a552-d2ff-4574-80e6-19fadaee69c8",
      "name": "Baixar CSV",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const csvTexto = $input.first().json.data || $input.first().json.body || '';\nconst janela = $('Calcular Data').first().json.janela;\n\nconst delimitador = csvTexto.includes(';') ? ';' : ',';\nconst linhas = csvTexto.split('\\n').filter(l => l.trim() !== '');\nif (linhas.length < 2) return [{ json: { erro: 'CSV vazio ou sem dados' } }];\n\nconst cabecalho = linhas[0].split(delimitador).map(c => c.trim());\nconst idxDuracao  = cabecalho.findIndex(c => c.toLowerCase().includes('dura'));\nconst idxDataHora = cabecalho.findIndex(c => c.toLowerCase().includes('data'));\nconst idxUsuario  = cabecalho.findIndex(c => c.toLowerCase().includes('usu'));\n\n// Converte HH:MM:SS em segundos\nfunction toSegundos(dur) {\n  const p = (dur || '').trim().split(':');\n  if (p.length !== 3) return 0;\n  return parseInt(p[0]) * 3600 + parseInt(p[1]) * 60 + parseInt(p[2]);\n}\n\n// Extrai só o nome do SDR: \"Vendas 4 Alisson\" -> \"Alisson\"\nfunction nomeSDR(usuario) {\n  const u = (usuario || '').trim();\n  // Remove o prefixo \"Vendas <numero> \" e fica com o resto\n  const m = u.match(/^vendas\\s+\\d+\\s+(.+)$/i);\n  if (m) return m[1].trim();\n  // Se não casar o padrão, devolve o valor original sem mexer\n  return u;\n}\n\n// Decide se a linha entra, conforme a janela de horário\nfunction passaFiltro(dataHora) {\n  const partes = (dataHora || '').trim().split(' ');\n  if (partes.length < 2) return false;\n  const [h, m] = partes[1].split(':').map(n => parseInt(n));\n  const minutos = h * 60 + m;       // minutos desde meia-noite\n  const corte   = 12 * 60 + 16;     // 12:16 = 736 minutos\n\n  if (janela === 'tarde') return minutos >= corte;  // 5h: a partir de 12:16\n  return minutos < corte;                           // 12:15: antes de 12:16\n}\n\nreturn linhas.slice(1).reduce((acc, linha) => {\n  const colunas = linha.split(delimitador).map(c => c.trim());\n\n  const dataHora = idxDataHora >= 0 ? (colunas[idxDataHora] || '') : '';\n  if (!passaFiltro(dataHora)) return acc;  // descarta fora da janela\n\n  const duracao  = idxDuracao >= 0 ? (colunas[idxDuracao] || '00:00:00') : '00:00:00';\n  const atendida = toSegundos(duracao) >= 60 ? 'Sim' : 'Não';\n\n  const obj = {};\n  cabecalho.forEach((col, i) => { obj[col] = colunas[i] || ''; });\n\n  // Sobrescreve a coluna Usuário com só o nome do SDR\n  if (idxUsuario >= 0) obj[cabecalho[idxUsuario]] = nomeSDR(colunas[idxUsuario]);\n\n  obj['Atendida'] = atendida;\n\n  acc.push({ json: obj });\n  return acc;\n}, []);"
      },
