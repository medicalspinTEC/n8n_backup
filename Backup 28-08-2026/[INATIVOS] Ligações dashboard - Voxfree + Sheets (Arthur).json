    {
      "parameters": {
        "jsCode": "const agora = new Date();\nconst hora = agora.getHours();\n\nconst d = new Date();\nlet janela;\n\nif (hora < 9) {\n  // disparo das 5h → ontem, ligações a partir de 12:16\n  d.setDate(d.getDate() - 1);\n  janela = 'tarde';\n} else {\n  // disparo das 12:15 → hoje, ligações até 12:15\n  janela = 'manha';\n}\n\nconst dd = String(d.getDate()).padStart(2, '0');\nconst mm = String(d.getMonth() + 1).padStart(2, '0');\nconst yyyy = d.getFullYear();\n\nconst data = `${dd}/${mm}/${yyyy}`;\nreturn [{ json: { reservation: `${data} - ${data}`, janela } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -240
      ],
      "id": "07f95232-1e3d-46c8-9d77-e88eff078c6b",
      "name": "Calcular Data"
    },
    {
      "parameters": {
        "jsCode": "const resposta = $input.first().json;\nconst caminho = (resposta.body || resposta.data || '').trim();\nconst caminhoLimpo = caminho.replace(/^\\.\\.\\//, '');\n\n// Separa diretório do nome do arquivo\nconst partes = caminhoLimpo.split('/');\nconst arquivo = partes.pop();\nconst diretorio = partes.join('/');\n\n// Codifica só o nome do arquivo (espaços, ç, õ)\nconst urlCSV = 'https://app.voxfree.com.br/' + diretorio + '/' + encodeURIComponent(arquivo);\n\nreturn [{ json: { csvUrl: urlCSV } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        -240
      ],
      "id": "ced299fd-7750-48bc-a54c-1a2f43854cc0",
      "name": "Montar URL CSV"
    },
