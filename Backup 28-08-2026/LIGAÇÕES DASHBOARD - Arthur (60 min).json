      "parameters": {
        "jsCode": "// Pega a ultima linha (mais recente) ja gravada na planilha,\n// para o Processar CSV saber a partir de onde continuar.\nconst items = $input.all();\nif (items.length === 0) {\n  return [{ json: { ultimaDataHora: null } }];\n}\nconst ultima = items[items.length - 1].json;\nreturn [{ json: { ultimaDataHora: ultima['Data / Hora'] || null } }];"
