    {
      "parameters": {
        "jsCode": "const camposIgnorados = [\n  '26.313.383/0001-41'\n];\n\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const dados = item.json;\n\n  const camposVazios = Object.entries(dados)\n    .filter(([campo, valor]) => {\n      if (camposIgnorados.includes(campo)) return false;\n\n      return valor === '' || valor === null || valor === undefined;\n    })\n    .map(([campo]) => campo);\n\n  if (camposVazios.length > 0) {\n    resultado.push({\n      id: dados.ID,\n      nome: dados.Nome,\n      instituicao: dados['Instituição'],\n      cnpj: dados.CNPJ,\n      camposVazios\n    });\n  }\n}\n\nlet mensagem = '';\n\nif (resultado.length === 0) {\n  mensagem = `\n    <h2>Todos os leads estão completos</h2>\n    <p>Nenhum lead possui campos vazios.</p>\n  `;\n} else {\n  mensagem = `\n    <h2>Leads com campos vazios</h2>\n    <p>Foram encontrados <strong>${resultado.length}</strong> leads com informações pendentes.</p>\n\n    <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n      <thead>\n        <tr>\n          <th>ID</th>\n          <th>Nome</th>\n          <th>Instituição</th>\n          <th>CNPJ</th>\n          <th>Campos vazios</th>\n        </tr>\n      </thead>\n      <tbody>\n  `;\n\n  for (const lead of resultado) {\n    mensagem += `\n      <tr>\n        <td>${lead.id ?? ''}</td>\n        <td>${lead.nome ?? ''}</td>\n        <td>${lead.instituicao ?? ''}</td>\n        <td>${lead.cnpj ?? ''}</td>\n        <td>${lead.camposVazios.join(', ')}</td>\n      </tr>\n    `;\n  }\n\n  mensagem += `\n      </tbody>\n    </table>\n  `;\n}\n\nreturn [\n  {\n    json: {\n      total: resultado.length,\n      mensagem\n    }\n  }\n];"
      },
