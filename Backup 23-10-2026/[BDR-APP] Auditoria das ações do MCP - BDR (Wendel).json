    {
      "parameters": {
        "jsCode": "\nconst resultado = $input.first().json.body.dados.resultado;\n\nconst linhas = [\n  `Consulta: ${resultado.ok ? 'sucesso' : 'falha'}`,\n  `Total de itens: ${resultado.totalItens}`,\n  `Lote: ${resultado.lote}/${resultado.totalLotes}`,\n  `Tamanho da página: ${resultado.tamanhoPagina}`,\n  `Existe próxima página/lote: ${resultado.temProximoLote ? 'sim' : 'não'}`,\n  ''\n];\n\nfor (const pagina of resultado.paginas ?? []) {\n  linhas.push(`=== Página ${pagina.pagina} (${pagina.quantidade} itens) ===`);\n\n  for (const lead of pagina.itens ?? []) {\n    linhas.push([\n      `ID: ${lead.id ?? 'não informado'}`,\n      `Nome: ${lead.nome ?? 'não informado'}`,\n      `Telefone: ${lead.telefone ?? 'não informado'}`,\n      `Negócio: ${lead.negocio ?? 'não informado'}`,\n      `Atividade: ${lead.atividade ?? 'não informado'}`,\n      `Status: ${lead.status ?? 'não informado'}`,\n      `Produto: ${lead.produto || 'não informado'}`,\n      `Marca: ${lead.marca || 'não informado'}`,\n      `Persona: ${lead.persona || 'não informado'}`,\n      `Região: ${lead.regiao || 'não informado'}`,\n      `CNPJ: ${lead.cnpj ?? 'não informado'}`,\n      `Criado em: ${lead.criadoEm ?? 'não informado'}`,\n      `Último contato: ${lead.ultimoContato ?? 'não informado'}`,\n      `Campanha principal: ${lead.campanhaNome ?? 'não informado'}`,\n      `Campanhas: ${(lead.campanhasNomes ?? []).join(', ') || 'nenhuma'}`,\n      `Mensagens enviadas: ${lead.mensagensEnviadas ?? 0}`,\n      `Respostas: ${lead.respostas ?? 0}`,\n      `Notas: ${lead.notas || 'nenhuma'}`\n    ].join('\\n'));\n\n    linhas.push('');\n  }\n}\n\nreturn [{\n  json: {\n    resumo: linhas.join('\\n')\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
