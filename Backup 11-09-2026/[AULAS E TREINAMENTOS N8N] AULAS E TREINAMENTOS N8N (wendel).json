    {
      "parameters": {
        "content": "# Comandos Básicos de Servidores Linux na MSP\n\n# Navegação\npwd                 # Mostra o diretório atual\nls                  # Lista arquivos\nls -la              # Lista incluindo arquivos ocultos\ncd /caminho         # Entra em uma pasta\ncd ..               # Volta um diretório\ncd ~                # Vai para a pasta do usuário\ntree                # Exibe estrutura de diretórios (se instalado)\n\n# Arquivos e Pastas\ntouch arquivo.txt           # Cria um arquivo\nmkdir pasta                 # Cria uma pasta\nmkdir -p pasta/subpasta     # Cria pastas em sequência\ncp origem destino           # Copia arquivo\ncp -r pasta1 pasta2         # Copia pasta\nmv origem destino           # Move ou renomeia\nrm arquivo                  # Remove arquivo\nrm -rf pasta                # Remove pasta e conteúdo\nfind . -name \"*.log\"        # Procura arquivos\n\n# Visualizar Arquivos\ncat arquivo.txt         # Mostra conteúdo\nless arquivo.txt        # Navega pelo arquivo\nmore arquivo.txt        # Exibe página por página\nhead arquivo.txt        # Primeiras linhas\ntail arquivo.txt        # Últimas linhas\ntail -f log.txt         # Acompanha um log em tempo real\n\n# Editores\nnano arquivo.txt\nvim arquivo.txt\n\n# Permissões\nchmod 755 arquivo\nchmod +x script.sh\nchown usuario:grupo arquivo\nsudo comando\n\n# Usuários\nwhoami\nid\npasswd\nadduser usuario\nuserdel usuario\ngroups\n\n# Processos\nps aux\ntop\nhtop                 # Se instalado\nkill PID\nkill -9 PID\npkill nome\n\n# Serviços\nsystemctl status nginx\nsystemctl start nginx\nsystemctl stop nginx\nsystemctl restart nginx  # Ferramenta de DevOps\nsystemctl reload nginx\nsystemctl enable nginx\nsystemctl disable nginx\nsystemctl list-units --type=service\n\n# Logs\njournalctl\njournalctl -u nginx\njournalctl -f\ndmesg\n\n# Rede\nip a\nip route\nping google.com\ncurl https://google.com\nwget https://site.com/arquivo.zip\nhostname\nhostname -I\nss -tulpn\nnetstat -tulpn          # Se instalado\n\n# SSH\nssh usuario@ip\nssh -p 2222 usuario@ip\nscp arquivo usuario@ip:/destino\nscp -r pasta usuario@ip:/destino\n\n# Disco\ndf -h\ndu -sh *\ndu -sh pasta\nlsblk\nmount\numount /dev/sdb1\n\n# Memória e CPU\nfree -h\nvmstat\nlscpu\nnproc\nuptime\n\n# Pacotes (Ubuntu/Debian)\nsudo apt update\nsudo apt upgrade\nsudo apt install nginx\nsudo apt remove nginx\nsudo apt autoremove\n\n# Compressão\nzip arquivo.zip pasta\nunzip arquivo.zip\ntar -czvf backup.tar.gz pasta\ntar -xzvf backup.tar.gz\n\n# Docker\ndocker ps\ndocker ps -a\ndocker images\ndocker logs container\ndocker logs -f container\ndocker exec -it container bash\ndocker restart container\ndocker stop container\ndocker start container\ndocker rm container\ndocker rmi imagem\ndocker compose up -d\ndocker compose down\ndocker compose logs -f\n\n# Monitoramento\ntop\nhtop\niotop\niftop\nwatch df -h\nwatch docker ps\n\n# Busca\ngrep \"texto\" arquivo\ngrep -R \"texto\" .\nfind / -name \"*.conf\"\nlocate nginx\nwhich node\nwhereis docker\n\n# Variáveis\necho $PATH\nenv\nexport NODE_ENV=production\n\n# Informações do Sistema\nuname -a\nhostnamectl\ncat /etc/os-release\ndate\ntimedatectl\n\n# date\ntimedatectl\n\n# Reiniciar e reboot\nreboot\nshutdown now\nshutdown -h now\nshutdown -r now\nshutdown +10",
        "height": 4528,
        "width": 624,
        "color": 3
      },
