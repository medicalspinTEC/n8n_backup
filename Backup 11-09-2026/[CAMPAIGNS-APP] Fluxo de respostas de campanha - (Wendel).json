      "parameters": {
        "jsCode": "const sender = $input.first().json.body.data.key.remoteJid;\n\nlet telefone = sender.split('@')[0];\n\n// Adiciona o 9 depois do DDD (Brasil)\nif (telefone.startsWith('55') && telefone.length === 12) {\n  telefone = telefone.slice(0, 4) + '9' + telefone.slice(4);\n}\n\nreturn [\n  {\n    json: {\n      telefone\n    }\n  }\n];"
