      {
        "parameters": {
          "jsCode": "const telefoneEntrada = $('Code in JavaScript').first().json.telefone;\n\nconst leads = $input.all();\n\nconst normalizarTelefone = (valor) => {\n  let telefone = String(valor || '').replace(/\\D/g, '');\n\n  // Adiciona o código do Brasil apenas para números\n  // nacionais de 10 ou 11 dígitos.\n  if (telefone.length === 10 || telefone.length === 11) {\n    telefone = '55' + telefone;\n  }\n\n  return telefone;\n};\n\nconst telefoneBusca = normalizarTelefone(telefoneEntrada);\n\n// Procura o telefone em TODOS os itens\nconst leadEncontrado = leads.find(item => {\n  const telefoneLead = normalizarTelefone(item.json.telefone);\n\n  return telefoneLead === telefoneBusca;\n});\n\nconst telefonePresente = !!leadEncontrado;\n\nconst temCampanha =\n  telefonePresente &&\n  Array.isArray(leadEncontrado.json.campanhasIds) &&\n  leadEncontrado.json.campanhasIds.length > 0;\n\nreturn [\n  {\n    json: {\n      telefone: telefoneBusca,\n      telefonePresente,\n      temCampanha,\n      valido: telefonePresente && temCampanha\n    }\n  }\n];"
        },
