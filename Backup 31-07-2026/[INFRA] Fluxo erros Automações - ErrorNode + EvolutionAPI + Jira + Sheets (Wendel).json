    {
      "parameters": {
        "jsCode": "const erroOriginal = $input.first().json.execution?.error?.message || \"\";\n\nconst traducoes = {\n  \"Erro ao enviar mensagem de texto\":\n    \"Não foi possível enviar a mensagem. Verifique a conexão, o número de destino ou tente novamente.\",\n\n  \"The service is receiving too many requests from you\":\n    \"O sistema recebeu muitas solicitações em um curto período. Aguarde alguns instantes e tente novamente.\",\n\n  \"Workflow did not finish, possible out-of-memory issue\":\n    \"A automação foi interrompida porque o servidor ficou sem memória ou recursos suficientes para concluir a execução.\",\n\n  \"Column names were updated after the node's setup\":\n    \"As colunas da planilha ou banco de dados foram alteradas depois que a automação foi configurada. Atualize a configuração do node.\",\n\n  \"Bad request - please check your parameters\":\n    \"A solicitação enviada contém informações inválidas ou incompletas. Verifique os dados informados e tente novamente.\",\n\n  \"Service unavailable - try again later or consider setting this node to retry automatically (in the node settings)\":\n    \"O serviço está temporariamente indisponível. Aguarde alguns minutos e tente novamente. Se o problema continuar, configure tentativas automáticas no node.\",\n\n  \"The resource you are requesting could not be found\":\n    \"O recurso solicitado não foi encontrado. Verifique se o ID, URL ou registro informado existe.\",\n\n  \"Mapear Novo Funil/Etapa\":    \n    \"Mapear Novo Funil/Etapa\",\n\n  \"The connection to the server was closed unexpectedly, perhaps it is offline. You can retry the request immediately or wait and retry later.\":\n    \"Sobrecarga de conexão na API do Google, execute o node novamente manualmente.\"\n};\n\nconst erroConhecido = erroOriginal in traducoes;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    erroOriginal,\n    erroTraduzido: erroConhecido\n      ? traducoes[erroOriginal]\n      : \"Erro ainda não catalogado.\",\n    erroConhecido\n  }\n}];"
      },
