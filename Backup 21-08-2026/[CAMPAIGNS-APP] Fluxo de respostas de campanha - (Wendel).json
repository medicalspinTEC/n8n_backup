        "jsCode": "const telefone = $('Code in JavaScript').first().json.telefone;\n\nconst leads = $input.first().json.leads || [];\n\nconst normalizarTelefone = (valor) =>\n  String(valor || '').replace(/\\D/g, '');\n\nconst telefoneBusca = normalizarTelefone(telefone);\n\nconst existe = leads.some(lead =>\n  normalizarTelefone(lead.telefone) === telefoneBusca\n);\n\nreturn [\n  {\n    json: {\n      telefone,\n      existe\n    }\n  }\n];"
